# Central file storage (optional). Without these the app stores files in the browser (IndexedDB),
# or in the claude.ai artifact store when it runs as an artifact.
# Schema: deploy/supabase.sql. Never commit a filled-in .env.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_SUPABASE_BUCKET=vault
# File quota shown in the app, in GB (Supabase free plan: 1; Pro: 100).
VITE_STORAGE_QUOTA_GB=
